{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "post",
          "value": "(?<post>[^/]+)"
        }
      ],
      "destination": "https://www.adultmentoring.co.uk/journal?post=:post",
      "statusCode": 301
    },
    {
      "source": "/",
      "destination": "https://www.adultmentoring.co.uk/youth-mentoring",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "https://www.adultmentoring.co.uk/youth-mentoring",
      "statusCode": 301
    },
    {
      "source": "/about",
      "destination": "https://www.adultmentoring.co.uk/our-mentors",
      "statusCode": 301
    },
    {
      "source": "/team",
      "destination": "https://www.adultmentoring.co.uk/our-mentors",
      "statusCode": 301
    },
    {
      "source": "/our-mentors",
      "destination": "https://www.adultmentoring.co.uk/our-mentors",
      "statusCode": 301
    },
    {
      "source": "/support",
      "destination": "https://www.adultmentoring.co.uk/youth-mentoring",
      "statusCode": 301
    },
    {
      "source": "/approach",
      "destination": "https://www.adultmentoring.co.uk/youth-mentoring",
      "statusCode": 301
    },
    {
      "source": "/safeguarding",
      "destination": "https://www.adultmentoring.co.uk/safeguarding",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "destination": "https://www.adultmentoring.co.uk/contact",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "destination": "https://www.adultmentoring.co.uk/journal",
      "statusCode": 301
    },
    {
      "source": "/journal",
      "destination": "https://www.adultmentoring.co.uk/journal",
      "statusCode": 301
    },
    {
      "source": "/privacy",
      "destination": "https://www.adultmentoring.co.uk/privacy",
      "statusCode": 301
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://www.adultmentoring.co.uk/sitemap.xml",
      "statusCode": 301
    },
    {
      "source": "/robots.txt",
      "destination": "https://www.adultmentoring.co.uk/robots.txt",
      "statusCode": 301
    },
    {
      "source": "/blog/:slug",
      "destination": "https://www.adultmentoring.co.uk/helpful-blogs/:slug",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://www.adultmentoring.co.uk/youth-mentoring",
      "statusCode": 301
    }
  ]
}
